# Supabase — public values, safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=your-anon-key

# Supabase — server-only, used for writes from the API routes.
# Required because RLS only allows public reads. Falls back to the anon
# key if unset (fine for local dev without RLS).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
