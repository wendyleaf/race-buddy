# Supabase — public values, safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=your-anon-key

# Supabase — server-only, used for writes from API routes and scripts.
# Required if RLS is enabled on the races table. Falls back to the anon
# key if unset (fine for local dev without RLS).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mapbox — public token, restrict by URL in your Mapbox dashboard
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token

# Server-only API keys for race discovery
EXA_API_KEY=your-exa-key
OPENAI_API_KEY=sk-your-openai-key
